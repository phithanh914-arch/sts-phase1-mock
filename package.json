{
  "name": "sts-phase1-mock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx server/src/eval/cli.ts"
  },
  "dependencies": {
    "express": "^4.22.3",
    "openai": "^7.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
