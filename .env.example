# ── 必須（外部公開時） ──
# 画面ログイン用パスワード。NODE_ENV=production で未設定なら起動しない。
APP_PASSWORD=
# Cookie署名用。未設定なら起動ごとにランダム（再起動でログアウトされる）。
SESSION_SECRET=

# ── OpenAI（サーバ側のみ。VITE_* などフロント用変数に入れないこと） ──
# 未設定なら音声(GPT-Live)とLLM Brainは無効。テキストのDeterministicモードは動く。
OPENAI_API_KEY=
# GPT-Live音声モデル（公式ドキュメント 2026-11-06 確認値）
LIVE_MODEL=gpt-live-1
# 音声。既定 harema（公式Voice options: Japanese/Feminine）。shida は Japanese/Masculine
LIVE_VOICE=harema
# 画面で選べる声（カンマ区切り）
LIVE_VOICES=harema,shida,marin
# 受付Brain（構造化抽出・会話方針）のResponses APIモデルID。未設定ならDeterministicのみ。
# 利用可能なモデルIDは実アカウントで確認してから設定すること（例は記載しない）。
BRAIN_MODEL=
BRAIN_TIMEOUT_MS=20000

# ── 費用・負荷の上限 ──
LIVE_MAX_SESSION_SECONDS=600
LIVE_MAX_CONCURRENT=1
LIVE_MAX_SESSIONS_PER_DAY=30
EVAL_MAX_LLM_RUNS=40

# ── 挙動 ──
LIVE_TURN_GAP_MS=900
CALL_WAIT_LIMIT_MS=20000
DATA_DIR=data
DATA_RETENTION_HOURS=72
# ローカル既定は 127.0.0.1。PORT が与えられる環境（Render等）では 0.0.0.0。
# HOST=127.0.0.1
# PORT=8787
